# LinkForge Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/linkforge

# Redis
REDIS_URL=redis://localhost:6379

# Application
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=false
LOG_LEVEL=INFO

# Rate Limiting
# Free-tier quota: shortening requests allowed per caller per UTC day.
# Callers are identified by the X-API-Key header when present, else by
# client IP. Counters live in Redis and reset at midnight UTC.
RATE_LIMIT_PER_DAY=100

# Azure Deployment (for CI/CD)
AZURE_CONTAINER_REGISTRY_URL=
AZURE_CONTAINER_INSTANCE_NAME=
AZURE_RESOURCE_GROUP=
