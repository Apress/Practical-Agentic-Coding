# ZenithStays backend: every environment variable that server.js and src/ read.
# Copy to .env (cp .env.example .env, or copy .env.example .env in Command Prompt).
# All of them are optional. With none set, the API listens on port 3001 and serves mock data.

# Port the Express server listens on. Default: 3001
PORT=3001

# AWS Region for the Bedrock agent runtime client and the AWS storage stub. Default: us-east-1
AWS_REGION=us-east-1

# Bedrock agent behind GET /api/dashboard/insight. Leave empty to serve the mock insight.
# Calling a real agent also needs AWS credentials the AWS SDK can find (see README.md).
STRATEGY_AGENT_ID=

# Alias of that agent. Empty means TSTALIASID, the test alias that points to the agent's DRAFT version.
STRATEGY_AGENT_ALIAS_ID=

# Storage adapter that src/services/cloud/CloudFactory.js returns: AWS or GCP. Default: AWS
CLOUD_PROVIDER=AWS
