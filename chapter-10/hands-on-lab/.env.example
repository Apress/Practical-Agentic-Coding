# Claude API Configuration
ANTHROPIC_API_KEY=your_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Swarm Configuration
MESSAGE_QUEUE_SIZE=1000
AGENT_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# Agent Configuration
# The agents send a temperature with every request (AGENT_TEMPERATURE plus
# per-call values in the agent code) and read each reply's first content block
# as text. claude-sonnet-4-6, a previous-generation model, accepts a
# temperature and does not think unless asked, so both hold. As of October 31,
# 2026, Anthropic serves it until at least February 17, 2027. Claude 4.7 and
# later models return a 400 error for a non-default temperature, and Claude 5
# models think by default, so a reply can start with a thinking block. To
# switch to one, remove the temperature argument in starter/base_agent.py and
# return the reply's first text block there. claude-sonnet-4-5 retires on
# November 30, 2026, so do not use it here.
DEV_AGENT_MODEL=claude-sonnet-4-6
QA_AGENT_MODEL=claude-sonnet-4-6
SCRUM_AGENT_MODEL=claude-sonnet-4-6
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.7

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Coordination Patterns
DEFAULT_COORDINATION_PATTERN=manager
ENABLE_PATTERN_METRICS=true

# Performance Settings
CONCURRENT_TASKS_LIMIT=5
TASK_TIMEOUT_SECONDS=120
BLACKBOARD_POLL_INTERVAL_SECONDS=1
