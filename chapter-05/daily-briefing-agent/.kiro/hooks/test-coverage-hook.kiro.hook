{
  "enabled": true,
  "name": "Auto Test Coverage",
  "description": "When a source file is modified, identifies new or modified functions and methods, checks if corresponding tests exist and cover the changes, generates test cases for missing coverage, runs tests to verify they pass, and updates coverage reports",
  "version": "1",
  "when": {
    "type": "PostFileSave",
    "patterns": [
      "*.py",
      "*.js",
      "*.ts",
      "*.java",
      "*.cpp",
      "*.c",
      "*.go",
      "*.rb",
      "*.php"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file has been modified. Please:\n1. Analyze the modified file to identify new or changed functions and methods\n2. Check if corresponding tests exist for these functions/methods\n3. Identify any gaps in test coverage for the new or modified code\n4. Generate thorough test cases for any missing coverage\n5. Run the tests to ensure they pass\n6. Update coverage reports to reflect the current state\n\nFocus on ensuring thorough test coverage for all new and modified functionality."
  }
}