# Daily Briefing Agent - Environment Configuration
# Copy this file to .env.local and customize for your environment

# ===========================================
# Environment Settings
# ===========================================
FLASK_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ===========================================
# Database Configuration
# ===========================================
# For local development with SQLite (default):
# DATABASE_URL=sqlite:///daily_briefing_dev.db

# For PostgreSQL (local or AWS):
# DATABASE_URL=postgresql://user:password@localhost:5432/daily_briefing

# For AWS with Secrets Manager:
# DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:daily-briefing/aurora-credentials

# ===========================================
# AWS Configuration
# ===========================================
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile-name

# ===========================================
# LocalStack (Local Development)
# ===========================================
# Enable for local AWS service simulation
USE_LOCALSTACK=false
LOCALSTACK_ENDPOINT=http://localhost:4566
# LocalStack also needs LOCALSTACK_AUTH_TOKEN set in your shell; Docker Compose does not read .env.local (see the lab README)

# ===========================================
# Amazon Bedrock Configuration
# ===========================================
# Enable/disable Bedrock integration (disable for offline development)
ENABLE_BEDROCK=true

# Model IDs for summary generation.
#
# The bedrock-runtime InvokeModel and Converse APIs (boto3 "bedrock-runtime")
# call current Claude models through an inference profile ID, not a bare model
# ID. The "global." profiles below work from any commercial Region and may route
# requests to any Region; use a geo profile such as "us." or "eu." instead to
# keep requests inside one geography. Each model's card under "Models at a
# glance" in the Amazon Bedrock User Guide lists its current IDs:
# https://docs.aws.amazon.com/bedrock/latest/userguide/model-cards.html
#
# Access: Bedrock enables a model the first time you call it, but Anthropic
# models need a one-time use-case form for your AWS account first (open a Claude
# model from Model catalog in the Bedrock console). Until that is done, calls
# fail with AccessDeniedException.
#
# The fallback model is used when the primary call fails. Keep it a DIFFERENT
# model from the primary (here the Sonnet tier backs up the Haiku tier), so one
# model's throttling or outage does not take both down.
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5
BEDROCK_FALLBACK_MODEL_ID=global.anthropic.claude-sonnet-5-5
BEDROCK_MAX_TOKENS=4096

# ===========================================
# S3 Configuration
# ===========================================
S3_BUCKET_NAME=daily-briefing-briefings

# ===========================================
# Web Scraping Configuration
# ===========================================
# Rate limit delay between requests (seconds)
HN_RATE_LIMIT_DELAY=1.0
MAX_STORIES_PER_COLLECTION=30

# ===========================================
# Flask Configuration
# ===========================================
# IMPORTANT: Change this in production!
SECRET_KEY=dev-secret-key-change-in-production

# ===========================================
# Feature Flags
# ===========================================
ENABLE_CACHING=true
