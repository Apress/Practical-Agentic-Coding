# DevMemory Configuration
# Copy this file to .env and fill in your key:
#   cp .env.example .env

# Required: OpenAI API key.
# Mem0's default LLM and embedder are OpenAI, so remember() and recall() make
# API calls. Get a key at https://platform.openai.com/api-keys
# Export it in your shell as well as setting it here, because Mem0 reads it
# from the environment rather than from this file:
#   export OPENAI_API_KEY=your_openai_api_key_here
# To run fully local instead, leave this blank and point Mem0 at Ollama; the
# lab README shows the config change.
OPENAI_API_KEY=your_openai_api_key_here

# The settings below are read only by load_config() in starter/config.py.
# The tests, demo.py, and the exercise snippets build DevMemoryConfig directly
# with its defaults, as the book's listings do, so changing a value here has
# no effect on them. Edit the defaults in starter/config.py instead, or call
# load_config() in code you write.

# ChromaDB Settings
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Project Name (used as Mem0 collection prefix)
PROJECT_NAME=devmemory-lab

# Memory Settings. CONSOLIDATION_MIN_EPISODES is the Pattern Mining minimum
# (Exercise 4). CONFIDENCE_THRESHOLD and RETENTION_DAYS are extension knobs:
# decay is the Exercise 5 extension (see the note in starter/config.py).
CONFIDENCE_THRESHOLD=0.5
CONSOLIDATION_MIN_EPISODES=3
RETENTION_DAYS=90
