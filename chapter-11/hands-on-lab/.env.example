# =============================================================================
# Zero-Downtime Deployer Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -----------------------------------------------------------------------------
# OPTIONAL: Claude API (only for your own agent extensions)
# -----------------------------------------------------------------------------
# No API key is required for any exercise: the lab runs entirely against mock
# infrastructure and never calls a paid API. Uncomment and fill these in only
# if you extend the deployer with your own model calls.
# Get a key from the Claude Console: https://platform.claude.com/
# Model IDs change; pick a current one from
# https://platform.claude.com/docs/en/models/overview
# claude-sonnet-5-5 rejects temperature, top_p, and top_k, and a reply can start
# with a thinking block, so read text blocks by type.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# -----------------------------------------------------------------------------
# Deployment Configuration
# -----------------------------------------------------------------------------
# Kubernetes namespace for deployments
DEPLOYMENT_NAMESPACE=default

# Canary deployment settings. These three are the defaults for any
# DeploymentConfig that does not set them; the test suite sets its own.
CANARY_PERCENTAGE=10                    # Initial canary traffic percentage
VALIDATION_DURATION_SECONDS=300         # How long to validate canary (5 minutes)
TRAFFIC_SHIFT_STEPS=10,25,50,100       # Progressive traffic shift percentages
TRAFFIC_STABILIZATION_SECONDS=30        # Pause after each shift; set 0 for fast test runs

# Health check thresholds
ERROR_RATE_THRESHOLD=0.01               # Max error rate (1%)
LATENCY_P99_THRESHOLD_MS=500            # Max p99 latency (500ms)
CPU_THRESHOLD_PERCENT=80                # Max CPU usage (80%)
MEMORY_THRESHOLD_PERCENT=80             # Max memory usage (80%)

# Rollback settings
AUTO_ROLLBACK_ENABLED=true              # Enable automatic rollback
ROLLBACK_TIMEOUT_SECONDS=600            # Loaded by config.py; rollback() does not enforce it

# -----------------------------------------------------------------------------
# DevMemory Integration (from Chapter 9)
# -----------------------------------------------------------------------------
# The lab's memory is a simplified, file-based store (memory_integration.py)
# that writes deployments.json under MEMORY_PERSIST_DIR. The other three
# values are loaded by config.py, but nothing in the lab uses them yet; they
# are here for when you swap in the Chapter 9 memory system.
MEMORY_PERSIST_DIR=./data/memory        # Local storage directory
MEMORY_BACKEND=chroma
MEMORY_COLLECTION_NAME=deployments
MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# OPTIONAL: Sentry Integration (Exercise 3)
# -----------------------------------------------------------------------------
# Sign up at: https://sentry.io/signup/ (the free Developer plan includes
# 5k errors; see https://sentry.io/pricing/)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=lab
# SENTRY_TRACES_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# OPTIONAL: Observability
# -----------------------------------------------------------------------------
# Loaded by config.py for your own extensions. The lab's health monitor
# simulates its metrics, so nothing here queries these endpoints.
# Prometheus endpoint
PROMETHEUS_URL=http://localhost:9090

# Grafana endpoint (if using)
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=                        # Not read by the lab code

# -----------------------------------------------------------------------------
# Infrastructure Settings
# -----------------------------------------------------------------------------
# Kubernetes cluster context. Not used yet: with mock mode off, the client
# loads your current kubeconfig context.
K8S_CONTEXT=

# Container registry (for custom images). Not read by the lab code; the mock
# infrastructure never pulls an image.
CONTAINER_REGISTRY=docker.io
CONTAINER_REGISTRY_USERNAME=
CONTAINER_REGISTRY_PASSWORD=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Loaded by config.py; the lab prints to stdout and does not use them yet.
LOG_LEVEL=INFO                          # Options: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json                         # Options: json, text

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# Keep this true. Every exercise and test runs against the mock. Setting it
# to false only loads your kubeconfig: the real-cluster branches in
# infrastructure_client.py are not implemented and still return mock results.
USE_MOCK_INFRASTRUCTURE=true
MOCK_API_URL=http://localhost:5678      # Not used by the lab code
