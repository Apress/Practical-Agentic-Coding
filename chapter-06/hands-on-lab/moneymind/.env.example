# MoneyMind Environment Variables
# Copy this file to .env and fill in your values

# Required: Gemini API key for Genkit
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Plaid API Credentials (for real bank integration)
# Get sandbox credentials at: https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret

# Data Source Toggle
# true = Use mock data (default for development)
# false = Use real Plaid API (requires credentials above)
USE_MOCK_DATA=true

# Optional: Application Environment
NODE_ENV=development
