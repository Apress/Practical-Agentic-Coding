{
  "permissions": {
    "allow": [
      "Bash(pytest*)",
      "Bash(mypy*)",
      "Bash(docker-compose up*)",
      "Bash(docker-compose logs*)",
      "Bash(docker-compose ps)",
      "Bash(docker compose up*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose ps)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Edit(/api/**)",
      "Edit(/database/**)",
      "Edit(/models/**)",
      "Edit(/services/**)",
      "Edit(/tests/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Edit(/.env)",
      "Edit(/.env.*)",
      "Edit(**/secrets/**)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-bash-command.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
