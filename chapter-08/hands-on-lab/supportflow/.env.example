# SupportFlow Environment Variables

# Database Configuration
DATABASE_URL=sqlite:///./supportflow.db
# For PostgreSQL: postgresql://user:password@localhost:5432/supportflow

# API Authentication
API_KEY=demo-key-12345

# Debug Settings
SQL_ECHO=false

# Bind address and port are set where the server is started:
# the Dockerfile CMD, or your local `uvicorn api.main:app --host ... --port ...`.
